{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/relatorios/excel", "destination": "/api/index.py?path=relatorios/excel" },
    { "source": "/(.*)", "destination": "/api/index.py?path=$1" }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{relatorios/**,__pycache__/**,*.db,*.bat,app.py}"
    }
  }
}
